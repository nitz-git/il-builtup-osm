  "rules": {
    "builtupLanduse": ["residential", "commercial", "retail"],
    "builtupPlace": ["city", "town", "village", "hamlet", "suburb", "quarter", "neighbourhood", "isolated_dwelling"],
    "placeExcludeIfKeys": ["admin_level"],
    "placeExcludeIfTags": {"boundary": ["administrative", "political", "census"]},
    "industrialLanduse": ["industrial"],
    "industrialAdjacencyM": 50,
    "corridorAlways": {"motorway": 35, "motorway_link": 15},
    "motorwayExemptClasses": ["motorway"],
    "corridorConditional": {"trunk": 25, "trunk_link": 12, "primary": 25, "primary_link": 12},
    "conditionalMaxspeedOverKmh": 80,
    "nonUrbanZoneValues": ["IL:rural", "IL:motorway"],
    "nonUrbanZoneKeys": ["maxspeed", "maxspeed:type", "source:maxspeed", "zone:traffic"],
    "tunnelCorridorMinLenM": 500,
    "tunnelCorridorBufferM": 30
  },
  "adminFallback": {
    "_doc": "Board PL-Q21 (b), 2026-10-12: a city or local council whose OSM built-up footprint is absent uses its municipal admin boundary, minus the same corridors. Never regional councils. See PROVENANCE.md.",
    "enabled": true,
    "boundaryValue": "administrative",
    "adminLevel": "8",
    "excludeNamePrefixes": ["מועצה אזורית", "מועצה תעשייתית", "מ.א.", "מ\"א"],
    "excludeNames": ["מגדל תפן", "נאות חובב"],
    "_excludeNamesDoc": "Industrial local councils (an industrial park, no residential locality): never a fallback, same reason as the isolated-industrial rule.",
    "excludeNameEnRegex": "(?i)regional\\s+council|industrial\\s+council",
    "maxSettlementNodes": 2,
    "settlementPlaceValues": ["city", "town", "village", "hamlet"],
    "maxAreaKm2": 50,
    "maxBuiltupShare": 0.01,
    "nonBuiltLanduse": ["farmland", "orchard", "meadow", "vineyard", "forest", "grass", "farmyard", "plant_nursery", "greenhouse_horticulture"],
    "nonBuiltNatural": ["wood", "scrub", "grassland", "heath", "bare_rock", "sand"],
    "boardNonBuiltLanduse": ["farmland", "orchard", "meadow"]
  },
  "geometry": {
    "metricCrs": "EPSG:32636",
    "closingM": 30,
    "holeFillMaxM2": 2000000,
    "simplifyToleranceM": 12,
    "minPolygonM2": 2000,
    "minHoleM2": 2000,
    "quantScale": 100000
